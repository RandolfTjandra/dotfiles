font-size = 13
# theme = One Dark
# theme = Cyberpunk
# theme = Catppuccin Frappe
theme = Dracula
scrollback-limit = 100000
split-divider-color = #3e4451
working-directory = ~/Dev
# Cursor effect preset from cursor-effects/ (switch with `cursor-fx <name>`, list with `cursor-fx`).
config-file = cursor-effects/lightning.conf

# Send Option as Alt so terminal apps (herdr, etc.) get Alt bindings.
macos-option-as-alt = true
# Ghostty binds alt+left/right to word jumps by default; free them for herdr pane focus.
keybind = alt+arrow_left=unbind
keybind = alt+arrow_right=unbind
